# AI MODEL CONFIGURATION
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_MODEL=meta/llama-2-70b-chat

# FALLBACK MODELS
OPENAI_API_KEY=optional_openai_key
OPENAI_MODEL=gpt-3.5-turbo

# DATABASE
DATABASE_URL=sqlite:///./mak_business.db
DATABASE_ECHO=false

# SYSTEM SETTINGS
SYSTEM_MODE=FIRST_EARNING_MODE
SYSTEM_STATE=RUNNING
EMERGENCY_STOP=false

# PAYMENT SETTINGS
UPI_ID=your-upi-id@bank
PHONE_PAYMENT_QR=qr_code_path.png
PAYMENT_VERIFICATION_METHOD=manual

# SOCIAL MEDIA (Optional OAuth)
LINKEDIN_CLIENT_ID=optional
LINKEDIN_CLIENT_SECRET=optional
YOUTUBE_API_KEY=optional
INSTAGRAM_API_KEY=optional

# EMAIL CONFIGURATION
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_app_password

# BROWSER AUTOMATION
BROWSER_TYPE=chrome
HEADLESS_MODE=true
BROWSER_TIMEOUT=30

# LOGGING
LOG_LEVEL=INFO
LOG_FILE=logs/mak.log

# APPROVAL SETTINGS
AUTO_APPROVAL_LEVEL=0
REQUIRE_HUMAN_APPROVAL=true
APPROVAL_TIMEOUT=3600

# OPERATION HOURS
OPERATION_HOURS_START=07
OPERATION_HOURS_END=23
TIMEZONE=Asia/Kolkata

# API RATE LIMITS
MAX_OUTREACH_PER_HOUR=20
MAX_API_CALLS_PER_MINUTE=10
REQUEST_TIMEOUT=30

# REVENUE TARGETS
DAILY_TARGET=100
WEEKLY_TARGET=500
MONTHLY_TARGET=2000

# DEBUG
DEBUG_MODE=false
VERBOSE_LOGGING=false
